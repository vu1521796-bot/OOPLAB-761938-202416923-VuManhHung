<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="450.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label fx:id="lblHeaderTitle" text="Title" wrapText="true" />
      <Label fx:id="lblHeaderDetail" text="Detail" wrapText="true" />
      <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="250.0" visible="false">
         <content>
            <VBox fx:id="tracksContainer" spacing="10.0" />
         </content>
      </ScrollPane>
   </children>
</VBox>